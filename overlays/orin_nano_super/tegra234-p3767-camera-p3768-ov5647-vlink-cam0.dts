/dts-v1/;
/plugin/;

/*
 * OV5647 (Raspberry Pi Camera v1.3) over Videtronic V-Link, Jetson Orin Nano /
 * Orin NX devkit (P3768 carrier), CAM0 connector.
 *
 * Camera graph, I2C mux, serializer and deserializer nodes are the same as in
 * tegra234-p3767-camera-p3768-imx219-vlink-cam0.dts. The OV5647 sensor node and
 * its mode timings come from https://github.com/akandr/ov5647-jetson
 * (dt/orin/tegra234-p3767-ov5647-overlay.dts, GPL-2.0, Copyright (C) 2026
 * Artur Andrzejczak), whose "nvidia,ov5647" driver this overlay binds to.
 *
 * Differences from the direct-attach overlay:
 * - reset-gpios is the serializer's MFP0 (the camera enable line on the ribbon)
 *   instead of a Jetson GPIO. The driver drives it high to power the module.
 * - The Jetson receives CSI from the deserializer, not from the sensor. With the
 *   serializer between sensor and NVCSI, NVIDIA's capture code does not apply
 *   the mode's lane_polarity / cil_settletime / clock rate to NVCSI (it would
 *   read string properties from the nvcsi channel node instead), so the Jetson
 *   side behaves as with the IMX219 V-Link overlay and link-freq is kept at its
 *   800 MHz. The sensor feeds the serializer at most 437.5 Mbps per lane.
 *
 * Untested on hardware.
 */

/ {
	overlay-name = "Camera OV5647 (CAM0) over v-link";
	jetson-header-name = "Jetson 24pin CSI Connector";
	compatible = "nvidia,p3768-0000+p3767-0000\0nvidia,p3768-0000+p3767-0001\0nvidia,p3768-0000+p3767-0003\0nvidia,p3768-0000+p3767-0004\0nvidia,p3768-0000+p3767-0005\0nvidia,p3768-0000+p3767-0000-super\0nvidia,p3768-0000+p3767-0001-super\0nvidia,p3768-0000+p3767-0003-super\0nvidia,p3768-0000+p3767-0004-super\0nvidia,p3768-0000+p3767-0005-super";
	
	fragment@0 {
		target-path = "/";
		__overlay__ {
			tegra-capture-vi {
				num-channels = <1>;
				ports {
					#address-cells = <1>;
					#size-cells = <0>;
					port@0 {
						reg = <0>;
						vi_in0: endpoint {
							port-index = <1>;
							bus-width = <2>;
							remote-endpoint = <&csi_out0>;
						};
					};
				};
			};
			tegra-camera-platform {
				compatible = "nvidia, tegra-camera-platform";
				/**
				* Physical settings to calculate max ISO BW
				*
				* num_csi_lanes = <>;
				* Total number of CSI lanes when all cameras are active
				*
				* max_lane_speed = <>;
				* Max lane speed in Kbit/s
				*
				* min_bits_per_pixel = <>;
				* Min bits per pixel
				*
				* vi_peak_byte_per_pixel = <>;
				* Max byte per pixel for the VI ISO case
				*
				* vi_bw_margin_pct = <>;
				* Vi bandwidth margin in percentage
				*
				* max_pixel_rate = <>;
				* Max pixel rate in Kpixel/s for the ISP ISO case
				* Set this to the highest pix_clk_hz out of all available modes.
				*
				* isp_peak_byte_per_pixel = <>;
				* Max byte per pixel for the ISP ISO case
				*
				* isp_bw_margin_pct = <>;
				* Isp bandwidth margin in percentage
				*/
				num_csi_lanes = <4>;
				max_lane_speed = <1500000>;
				min_bits_per_pixel = <10>;
				vi_peak_byte_per_pixel = <2>;
				vi_bw_margin_pct = <25>;
				max_pixel_rate = <7500000>;
				isp_peak_byte_per_pixel = <5>;
				isp_bw_margin_pct = <25>;
				
				modules {
					module0 {
						badge = "cam0_ov5647";
						position = "rear";
						orientation = "1";
						
						drivernode0 {
							pcl_id = "v4l2_sensor";
							sysfs-device-tree = "/sys/firmware/devicetree/base/bus@0/cam_i2cmux/i2c@0/ov5647_0@36";
						};
					};
				};
			};
			bus@0 {
				host1x@13e00000 {
					nvcsi@15a00000 {
						num-channels = <1>;
						#address-cells = <1>;
						#size-cells = <0>;
						channel@0 {
							reg = <0>;
							ports {
								#address-cells = <1>;
								#size-cells = <0>;
								port@0 {
									reg = <0>;
									csi_in0: endpoint@0 {
										port-index = <1>;
										bus-width = <2>;
										remote-endpoint = <&v_link_deser_out>;
									};
								};
								
								port@1 {
									reg = <1>;
									csi_out0: endpoint@1 {
										remote-endpoint = <&vi_in0>;
									};
								};
							};
						};
					};
				};
				cam_i2cmux {
					status = "okay";
					compatible = "i2c-mux-gpio";
					#address-cells = <1>;
					#size-cells = <0>;
					mux-gpios = <&gpio_aon 19 0>;//TEGRA234_AON_GPIO(CC, 3)
					i2c-parent = <&cam_i2c>;
					i2c@0 {
						status = "okay";
						reg = <0>;
						#address-cells = <1>;
						#size-cells = <0>;
						
						serializer_a: serializer@42 {
							status = "okay";
							compatible = "videtronic,v-link-ser";
							reg = <0x42>;
							gpio-controller;
							#gpio-cells = <2>;
							bus-width = <2>;
							
							ports {
								#address-cells = <1>;
								#size-cells = <0>;
								port@0 {
									reg = <0>;
									status = "okay";
									v_link_ser_in: endpoint@0 {
										status = "okay";
										port-index = <0>;
										bus-width = <2>;
										remote-endpoint = <&ov5647_out0>;
									};
								};
								port@1 {
									reg = <1>;
									status = "okay";
									v_link_ser_out: endpoint@1 {
										status = "okay";
										port-index = <1>;
										remote-endpoint = <&v_link_deser_in>;
									};
								};
							};
						};
						
						deserializer: deserializer@4c {
							status = "okay";
							compatible = "videtronic,v-link-deser";
							reg = <0x4c>;
							bus-width = <2>;
							link-freq = "800000000";
							ports {
								#address-cells = <1>;
								#size-cells = <0>;
								port@0 {
									reg = <0>;
									status = "okay";
									v_link_deser_in: endpoint@0 {
										status = "okay";
										port-index = <0>;
										remote-endpoint = <&v_link_ser_out>;
									};
								};
								port@1 {
									reg = <1>;
									status = "okay";
									v_link_deser_out: endpoint@1 {
										status = "okay";
										port-index = <1>;
										bus-width = <2>;
										remote-endpoint = <&csi_in0>;
									};
								};
							};
						};
						
						ov5647_0@36 {
							status = "okay";
							
							compatible = "nvidia,ov5647";
							/* I2C device address */
							reg = <0x36>;
							
							/* V4L2 device node location */
							devnode = "video0";
							
							/* Physical dimensions of sensor: 2592 x 1944 at 1.4 um */
							physical_w = "3.629";
							physical_h = "2.722";
							sensor_model = "ov5647";
							
							use_sensor_mode_id = "true";
							
							/* Module enable (ribbon PWDN line), driven high by the driver */
							reset-gpios = <&serializer_a 0 0>;
							
							mode0 { /* OV5647_MODE_2592x1944_15FPS */
								mclk_khz = "25000";
								num_lanes = "2";
								tegra_sinterface = "serial_b";
								lane_polarity = "6";
								phy_mode = "DPHY";
								discontinuous_clk = "yes";
								dpcm_enable = "false";
								cil_settletime = "0";
								active_w = "2592";
								active_h = "1944";
								mode_type = "bayer";
								pixel_phase = "bggr";
								csi_pixel_bit_depth = "10";
								readout_orientation = "0";
								line_length = "2844";
								inherent_gain = "1";
								mclk_multiplier = "3.50";
								pix_clk_hz = "87500000";
								gain_factor = "16";
								framerate_factor = "1000000";
								exposure_factor = "1000000";
								min_gain_val = "16";
								max_gain_val = "1023";
								step_gain_val = "1";
								default_gain = "16";
								min_hdr_ratio = "1";
								max_hdr_ratio = "1";
								min_framerate = "2000000";
								max_framerate = "15000000";
								step_framerate = "1";
								default_framerate = "15000000";
								min_exp_time = "131";
								max_exp_time = "500000";
								step_exp_time = "1";
								default_exp_time = "16666";
								embedded_metadata_height = "0";
							};
							mode1 { /* OV5647_MODE_1920x1080_30FPS */
								mclk_khz = "25000";
								num_lanes = "2";
								tegra_sinterface = "serial_b";
								lane_polarity = "6";
								phy_mode = "DPHY";
								discontinuous_clk = "yes";
								dpcm_enable = "false";
								cil_settletime = "0";
								active_w = "1920";
								active_h = "1080";
								mode_type = "bayer";
								pixel_phase = "bggr";
								csi_pixel_bit_depth = "10";
								readout_orientation = "0";
								line_length = "2416";
								inherent_gain = "1";
								mclk_multiplier = "3.50";
								pix_clk_hz = "87500000";
								gain_factor = "16";
								framerate_factor = "1000000";
								exposure_factor = "1000000";
								min_gain_val = "16";
								max_gain_val = "1023";
								step_gain_val = "1";
								default_gain = "16";
								min_hdr_ratio = "1";
								max_hdr_ratio = "1";
								min_framerate = "2000000";
								max_framerate = "32800000";
								step_framerate = "1";
								default_framerate = "30000000";
								min_exp_time = "111";
								max_exp_time = "500000";
								step_exp_time = "1";
								default_exp_time = "16666";
								embedded_metadata_height = "0";
							};
							mode2 { /* OV5647_MODE_1296x972_30FPS */
								mclk_khz = "25000";
								num_lanes = "2";
								tegra_sinterface = "serial_b";
								lane_polarity = "6";
								phy_mode = "DPHY";
								discontinuous_clk = "yes";
								dpcm_enable = "false";
								cil_settletime = "0";
								active_w = "1296";
								active_h = "972";
								mode_type = "bayer";
								pixel_phase = "bggr";
								csi_pixel_bit_depth = "10";
								readout_orientation = "0";
								line_length = "1896";
								inherent_gain = "1";
								mclk_multiplier = "3.50";
								pix_clk_hz = "87500000";
								gain_factor = "16";
								framerate_factor = "1000000";
								exposure_factor = "1000000";
								min_gain_val = "16";
								max_gain_val = "1023";
								step_gain_val = "1";
								default_gain = "16";
								min_hdr_ratio = "1";
								max_hdr_ratio = "1";
								min_framerate = "2000000";
								max_framerate = "32160000";
								step_framerate = "1";
								default_framerate = "30000000";
								min_exp_time = "87";
								max_exp_time = "500000";
								step_exp_time = "1";
								default_exp_time = "16666";
								embedded_metadata_height = "0";
							};
							mode3 { /* OV5647_MODE_640x480_62FPS */
								mclk_khz = "25000";
								num_lanes = "2";
								tegra_sinterface = "serial_b";
								lane_polarity = "6";
								phy_mode = "DPHY";
								discontinuous_clk = "yes";
								dpcm_enable = "false";
								cil_settletime = "0";
								active_w = "640";
								active_h = "480";
								mode_type = "bayer";
								pixel_phase = "bggr";
								csi_pixel_bit_depth = "10";
								readout_orientation = "0";
								line_length = "1852";
								inherent_gain = "1";
								mclk_multiplier = "2.33";
								pix_clk_hz = "58333300";
								gain_factor = "16";
								framerate_factor = "1000000";
								exposure_factor = "1000000";
								min_gain_val = "16";
								max_gain_val = "1023";
								step_gain_val = "1";
								default_gain = "16";
								min_hdr_ratio = "1";
								max_hdr_ratio = "1";
								min_framerate = "2000000";
								max_framerate = "62000000";
								step_framerate = "1";
								default_framerate = "62000000";
								min_exp_time = "127";
								max_exp_time = "500000";
								step_exp_time = "1";
								default_exp_time = "16666";
								embedded_metadata_height = "0";
							};
							mode4 { /* OV5647_MODE_1280x720_60FPS */
								mclk_khz = "25000";
								num_lanes = "2";
								tegra_sinterface = "serial_b";
								lane_polarity = "6";
								phy_mode = "DPHY";
								discontinuous_clk = "yes";
								dpcm_enable = "false";
								cil_settletime = "0";
								active_w = "1280";
								active_h = "720";
								mode_type = "bayer";
								pixel_phase = "bggr";
								csi_pixel_bit_depth = "10";
								readout_orientation = "0";
								line_length = "1896";
								inherent_gain = "1";
								mclk_multiplier = "3.50";
								pix_clk_hz = "87500000";
								gain_factor = "16";
								framerate_factor = "1000000";
								exposure_factor = "1000000";
								min_gain_val = "16";
								max_gain_val = "1023";
								step_gain_val = "1";
								default_gain = "16";
								min_hdr_ratio = "1";
								max_hdr_ratio = "1";
								min_framerate = "2000000";
								max_framerate = "60000000";
								step_framerate = "1";
								default_framerate = "60000000";
								min_exp_time = "87";
								max_exp_time = "500000";
								step_exp_time = "1";
								default_exp_time = "16666";
								embedded_metadata_height = "0";
							};
							
							ports {
								#address-cells = <1>;
								#size-cells = <0>;
								port@0 {
									reg = <0>;
									ov5647_out0: endpoint {
										port-index = <1>;
										bus-width = <2>;
										remote-endpoint = <&v_link_ser_in>;
									};
								};
							};
						};
					};
				};
			};
		};
	};
};
